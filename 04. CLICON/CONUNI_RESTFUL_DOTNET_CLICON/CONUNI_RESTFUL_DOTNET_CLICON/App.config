<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings>
    <!-- Cambiar SOLO esta dirección para apuntar a otro servidor (por ejemplo http://192.168.1.10:8086). -->
    <add key="UrlServidor" value="http://192.168.100.3:8086" />
  </appSettings>
</configuration>
