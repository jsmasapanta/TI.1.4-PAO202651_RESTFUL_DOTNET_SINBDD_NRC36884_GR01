@startuml DC_Clientes
!include ../_estilo.iuml
title Diagrama de clases — Clientes (MVC + Singleton, como el GR05), ejemplo: escritorio

package "ec.edu.monster.vista" {
  class FormLogin
  class FormPrincipal
  class PanelConversion
  class CatalogoConversiones <<static>> {
    + Todas : List<Conversion>  (16)
    + UnidadesOrigen(c) : List<Unidad>
    + UnidadesDestino(c, origen) : List<Unidad>
    + Buscar(origen, destino) : Conversion
  }
  class Formato <<static>> {
    + IntentarLeerNumero(texto, out valor) : bool
    + Numero(valor) : string
    + Monster() : Image
  }
  class Tema <<static>>
}

package "ec.edu.monster.controlador" {
  class ControladorConversion {
    + UsuarioActual : string
    + IniciarSesionAsync(usuario, clave) : Task
    + ConvertirAsync(conversion, valor) : Task<double>
    + CerrarSesion()
  }
}

package "ec.edu.monster.servicio" {
  class ClienteConversion <<Singleton>> {
    - {static} _instancia : Lazy<ClienteConversion>
    + {static} Instancia : ClienteConversion
    - _http : HttpClient
    - ClienteConversion()
    + Login(usuario, clave) : RespuestaLogin  (POST api/autenticacion/login)
    + Convertir(ruta, valor) : double  (GET api/{ruta}?valor=)
  }
  class ErrorServicioException
  class Json <<static>>
}

package "ec.edu.monster.modelo  (solo get/set)" {
  enum Categoria {
    Temperatura
    Longitud
    Masa
  }
  class Conversion {
    + Categoria : Categoria
    + Ruta : string
    + UnidadOrigen, SimboloOrigen : string
    + UnidadDestino, SimboloDestino : string
  }
  class SolicitudLogin {
    + Usuario, Clave : string
  }
  class RespuestaLogin {
    + Autenticado : bool
    + Usuario, Mensaje : string
  }
  class ResultadoConversion {
    + Valor, Resultado : double
  }
  class ErrorServicio {
    + Codigo : string
    + Mensaje : string
  }
}

FormLogin --> ControladorConversion
FormPrincipal --> ControladorConversion
FormPrincipal *-- PanelConversion
PanelConversion --> ControladorConversion
PanelConversion ..> CatalogoConversiones
PanelConversion ..> Formato
CatalogoConversiones ..> Conversion
ControladorConversion --> ClienteConversion : Instancia
ClienteConversion ..> Json
ClienteConversion ..> SolicitudLogin
ClienteConversion ..> RespuestaLogin
ClienteConversion ..> ResultadoConversion
ClienteConversion ..> ErrorServicioException
ErrorServicioException ..> ErrorServicio

note bottom of ClienteConversion
  Sin reglas: el login con 3 intentos y los rangos
  (cero absoluto, negativos) los valida el servidor;
  su mensaje llega en el JSON de error (400/401).
  Consola: VistaConsola + ControladorConsola.
  Web: ClienteConversion con AddSingleton.
  Móvil: ClienteRest.Instancia (HttpClient + System.Text.Json).
end note
@enduml
